# Optional default provider override: gemini | openai | anthropic | deepseek | custom
# If omitted, the server automatically uses the first configured provider below.
LLM_PROVIDER=

# Google Gemini (default in AI Studio)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL=

# OpenAI / ChatGPT (default model: gpt-4o-mini)
OPENAI_API_KEY=
OPENAI_MODEL=

# Anthropic / Claude (default model: claude-3-5-haiku-latest)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# DeepSeek (default model: deepseek-chat)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Custom OpenAI-compatible API (e.g. OpenRouter, Groq, Mistral, Ollama, vLLM)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
CUSTOM_LLM_LABEL=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
